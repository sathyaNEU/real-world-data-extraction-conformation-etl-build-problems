  "stump_strategies": {
    "withheld_rule_official_decoy": "RETIRED for new draws (client two-layer standard, 2026-10-11): the decisive rule is in no shipped sentence and is recovered from settled cases, while a filed, official-looking rule or basis gives the wrong answer; kept so older cards validate",
    "withheld_rule_corpus_fit": "the decisive rule is in no shipped sentence and is recovered by fitting settled cases, with no official-looking rival rule filed",
    "stated_rule_hard_construction": "the rule is filed in full and the difficulty is building the quantity it defines across files and grains",
    "forecast_method_backtest": "forecast or model selection on honest history: structural break, seasonality, regime or horizon makes the natural fit wrong out of sample",
    "maturity_censoring": "open periods are not fully developed: right-censoring, lag triangles, run-off or late arrival",
    "binding_constraint": "a capacity, budget, eligibility or service limit binds and removes the natural pick",
    "grain_or_unit": "the file's row grain or unit is not the decision's unit: episodes, members, households, per-unit normalisation, conversion",
    "population_selection": "who is in the denominator: survivorship, selection, attrition, exposure, scope",
    "composition_mix": "mix shift, Simpson's reversal, standardisation or reweighting changes the comparison",
    "time_semantics": "point-in-time, as-of, fiscal or service calendars, time zones, effective dating, supersession",
    "identity_resolution": "entity matching: reused, merged or split identifiers, many-to-many crosswalks, hierarchy roll-up",
    "decomposition_attribution": "an outcome split across causes, components or periods, where overlap or interaction decides the split",
    "causal_design": "confounding, spillover or interference, regression to the mean, control or comparison choice, pre-trends",
    "uncertainty_hold": "signal against noise, multiple comparisons, power or sample size; holding can be the answer",
    "other": "none of the above, named in the card's notes (never counts as a collision)"
  },
