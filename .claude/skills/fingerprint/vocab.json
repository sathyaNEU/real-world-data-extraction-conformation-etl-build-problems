  "layer2_families": {
    "estimand_identification": "the right counterfactual: staggered adoption, contamination and spillover, regression to the mean, selection on the outcome, Simpson's paradox across strata",
    "estimation_fit": "estimation that fits the data: censoring and truncation, interval-censored or rounded values, survivorship, small-sample bias, clustered errors, weighting and post-stratification, ratio of totals against mean of ratios, chain-linked aggregation, decomposition",
    "forecast_uncertainty": "forecasting and uncertainty: backtests without leakage, conformal or bootstrap intervals, simultaneous against pointwise bounds, model choice on out-of-sample error",
    "allocation_constraints": "allocation under real constraints: fixed-point allocations, max-min choices, capacity and queueing, the order a rule applies caps and tests",
    "field_method": "the field's own method done right: credibility weighting, development triangles, exposure windows, survey construction from microdata, market definition, intention to treat"
  },
  "stump_classes": {
    "analytical": "the answer turns on doing the analysis correctly: a strong analyst who cleaned the data and read every field and rule correctly still gets it wrong by taking the easy route (the estimand, the comparison group, the data's real structure, how the evidence is judged, how a forecast is validated). Choosing the right estimand or unit of analysis counts as analysis.",
    "planted": "a defect, decoy or hidden rule inserted only so that catching it flips the answer (a copied block, a staff memo arguing for the wrong answer, a rule recovered from settled cases). Banned as the decisive stump.",
    "data_semantics": "the answer flips only on reading a field, code, unit or definition correctly (a capacity column that also counts preschool seats, a rainfall column of multi-day totals). Banned as the decisive stump.",
    "rule_application": "the answer comes from applying stated rules correctly, however many steps there are (checking listed eligibility criteria and a stated score, following transfer records to a date). Banned as the decisive stump."
  }
}
